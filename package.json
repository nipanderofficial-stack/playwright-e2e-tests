{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright end to end tests",
  "main": "index.js",
  "scripts": {
    "test:login": "npx playwright test --config=config/test.playwright.config.ts tests/functional/Login.spec.ts --headed",
    "debug-cli": "PWDEBUG=1 npx playwright test tests/demo/login.spec.ts",
    "debug-ui": "npx playwright test tests/demo/login.spec.ts --ui --headed",
    "login-cura": "npx playwright test tests/demo/login.spec.ts --headed",
    "demo_firefox": "npx playwright test tests/demo/mytest.spec.ts --project=\"firefox\" --headed",
    "demo_chrome": "npx playwright test tests/demo/mytest.spec.ts --project=\"chromium\" --headed",
    "demo": "npx playwright test tests/demo/mytest.spec.ts --headed",
    "login": "npx playwright test tests/functional/Appointment.spec.ts --headed",
    "login:tag": "npx playwright test tests/demo/login_tag.spec.ts --headed",
    "multi-window": "npx playwright test tests/functional/multi.window.spec.ts --headed",
    "login-test": "npx playwright test tests/demo/login-test.spec.ts --headed"

  },
  "keywords": [],
  "author": "Nipander",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "allure-playwright": "^3.10.2",
    "chalk": "^6.0.0",
    "cross": "^1.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12"
  }
}
